# Secrets / local config
.env
.env.*
!.env.example
*.pem
*.pfx

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Engagement output — may contain customer-identifying metadata
output/*
!output/.gitkeep

# Raw API dumps (also under output/, but defense in depth)
**/raw/
**/*.raw.json
**/scanner-*.json
**/tenant-settings-*.json

# IDE
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db

# Node
node_modules/

# Local-only cover logo / brand assets (keep brand images out of the repo)
reports/images/*.png

# Disposable private-branch Fabric setup (may contain a short-lived token in local copies)
fabric/setup_private_*_DISPOSABLE.ipynb
