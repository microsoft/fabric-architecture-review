{
  "name": "fabric-architecture-review-app",
  "description": "Interactive Microsoft Fabric architecture review workbench with semantic model and Data Agent integration.",
  "license": "MIT",
  "author": "Microsoft",
  "private": true,
  "version": "2026.9.0",
  "type": "module",
  "scripts": {
    "generate:fabric": "node ./node_modules/@microsoft/fabric-app-data-cli/dist/index.js generate -o src/fabric.generated.ts",
    "predev": "rayfin env --framework vite && npm run generate:fabric",
    "prebuild": "rayfin env --framework vite",
    "prebuild:fabric": "rayfin env --framework vite",
    "dev": "vite",
    "build": "npm run generate:fabric && tsc -b && vite build",
    "build:fabric": "npm run generate:fabric && tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:fabric": "node scripts/open-fabric-portal.mjs",
    "agent:ask": "node scripts/query-data-agent.mjs"
  },
  "dependencies": {
    "@azure/msal-browser": "^5.18.0",
    "@microsoft/fabric-app-data": "1.1.0",
    "@microsoft/fabric-app-data-embed-client": "1.0.0",
    "@microsoft/fabric-app-data-proxy": "1.0.0",
    "@microsoft/fabric-visuals-core": "2.0.0",
    "@microsoft/rayfin-auth-provider-fabric": "^1.33.1",
    "@microsoft/rayfin-client": "^1.33.1",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@tailwindcss/vite": "^4.3.0",
    "clsx": "^2.1.1",
    "lucide-react": "^1.17.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-error-boundary": "^6.1.2",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.0",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "@microsoft/fabric-app-data-cli": "2.0.0",
    "@microsoft/rayfin-cli": "^1.33.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react-swc": "^4.3.1",
    "eslint": "^10.4.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "jsdom": "^29.1.1",
    "rollup-plugin-license": "^3.7.1",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.38.0",
    "vite": "^8.0.16",
    "vitest": "^4.1.8"
  }
