EVALUATE
SELECTCOLUMNS(
    FILTER('gold_run_summary', 'gold_run_summary'[is_latest] = TRUE()),
    "run_id", 'gold_run_summary'[run_id],
    "client_name", 'gold_run_summary'[client_name],
    "total_findings", 'gold_run_summary'[total_findings],
    "critical_fail", 'gold_run_summary'[critical_fail],
    "high_fail", 'gold_run_summary'[high_fail],
    "assessment_coverage", 'gold_run_summary'[assessment_coverage],
    "unknown_count", 'gold_run_summary'[unknown_count],
    "missing_evidence_count", 'gold_run_summary'[missing_evidence_count],
    "score", 'gold_run_summary'[score]
)