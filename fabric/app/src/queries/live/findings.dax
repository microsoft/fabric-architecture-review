DEFINE
    VAR LatestRun = MAXX(FILTER('gold_run_summary', 'gold_run_summary'[is_latest] = TRUE()), 'gold_run_summary'[run_id])
EVALUATE
TOPN(
    1000,
    SELECTCOLUMNS(
        FILTER('gold_findings', 'gold_findings'[run_id] = LatestRun && 'gold_findings'[is_fail] = 1),
        "rule_id", 'gold_findings'[rule_id],
        "dimension", 'gold_findings'[dimension],
        "severity", 'gold_findings'[severity],
        "severity_rank", 'gold_findings'[severity_rank],
        "title", 'gold_findings'[title],
        "affected", 'gold_findings'[affected],
        "recommendation", 'gold_findings'[recommendation],
        "pipeline_evidence", IF('gold_findings'[rule_id] = "ARCH-016", 'gold_findings'[evidence_json], BLANK())
    ),
    [severity_rank], ASC,
    [rule_id], ASC
)