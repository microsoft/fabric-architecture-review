# Public browser configuration. These values are identifiers, not credentials.
# Never add client secrets, access tokens, connection strings, or private keys.

# Microsoft Entra single-tenant SPA registration with delegated
# DataAgent.Execute.All permission and admin consent.
RAYFIN_PUBLIC_ENTRA_CLIENT_ID=11111111-2222-4333-8444-555555555555

# Published Fabric Data Agent and the workspace that contains that item.
# The workspace can differ from the app and semantic-model workspaces.
RAYFIN_PUBLIC_DATA_AGENT_ID=66666666-7777-4888-8999-aaaaaaaaaaaa
RAYFIN_PUBLIC_DATA_AGENT_WORKSPACE_ID=bbbbbbbb-cccc-4ddd-8eee-ffffffffffff

# Local Vite development port.
RAYFIN_PUBLIC_FRONTEND_PORT=5173

# Rayfin writes the remaining RAYFIN_PUBLIC_* values after app selection or
# deployment, including TENANT_ID, WORKSPACE_ID, ITEM_ID, API_URL, and
# PUBLISHABLE_KEY. Run `rayfin env --framework vite` to generate .env.local.