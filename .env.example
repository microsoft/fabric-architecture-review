# Local review settings. See docs/local-review.md and docs/auth-setup.md.
# Copy to .env; never commit credentials or live tenant metadata.

# Interactive sign-in to the tenant you have user/guest access to.
TENANT_ID=00000000-0000-0000-0000-000000000000

# Optional public-client override; defaults to the Azure CLI client ID.
# CLIENT_ID=
FABRIC_SCOPE=https://api.fabric.microsoft.com/.default
POWERBI_SCOPE=https://analysis.windows.net/powerbi/api/.default

# Report labels
CLIENT_NAME=Contoso
ENGAGEMENT_NAME=Fabric Architecture Review
REVIEWER_NAME=
REVIEW_DATE=

# Optional PDF branding: empty means no organization label or logo.
# REPORT_BRAND=
# REPORT_LOGO=
# FOOTER_LABEL=

# Use a separate directory per engagement, e.g. output/contoso.
OUTPUT_DIR=output

# Comma/whitespace-separated workspace GUIDs. Start with one test workspace.
# Empty means no workspace filter within the identity's access.
# Tenant-level collectors still return tenant-level facts.
# WORKSPACE_IDS=

# Activity lookback, 1-28 days. ACTIVITY_DAYS_LOG is the preferred name;
# ACTIVITY_LOG_DAYS remains supported for existing local configurations.
ACTIVITY_LOG_DAYS=7

# Skip Fabric-only VertiPaq and Semantic Link BPA/health analysis locally.
# The local PowerShell/Bash launchers enforce these values after loading .env.
# Fabric's 01_Collect notebook runs these checks separately.
VERTIPAQ_STATS_SKIP=true
BEST_PRACTICES_SKIP=true

# Optional probes (disabled unless enabled explicitly).
# See docs/data-safety.md for collection boundaries and required permissions.
#
# Capacity Metrics App semantic-model queries (DAX via executeQueries).
# Microsoft does not support custom consumption of this app's model.
# CAPACITY_METRICS_APP_INSTALLED=false
#
# Azure ARM pause/resume detection (local only; requires Azure sign-in
# and subscription Reader). Restrict the scan with AZURE_SUBSCRIPTION_ID.
# CAPACITY_AUTO_PAUSE_CONFIGURED=false
# AZURE_SUBSCRIPTION_ID=
#
# Fabric-only VertiPaq: default uses metadata DMVs. Opt in to aggregate
# column-cardinality queries (counts only, not customer business rows).
# VERTIPAQ_STATS_READ_DATA=false

# Numeric thresholds: config/thresholds.yaml is the canonical reference.
# Precedence: environment override > thresholds.yaml > built-in default.
# Example override:
# PERF_MODEL_SIZE_WARN_MB=2048
