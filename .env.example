# Local review settings. Copy to .env.far in the repository root.
# Never commit .env.far, credentials or live tenant metadata. See docs/local-review.md
# and docs/auth-setup.md. In Fabric these settings live in the Variable Libraries and
# pipeline parameters created by setup instead.

# --- Identity ---------------------------------------------------------------------------
# Interactive sign-in to the tenant you have access to (required for local runs).
TENANT_ID=00000000-0000-0000-0000-000000000000

# Optional unattended service principal. Set both to run without a person signed in;
# load CLIENT_SECRET from your secret store at run time instead of writing it here.
# CLIENT_ID=
# CLIENT_SECRET=

FABRIC_SCOPE=https://api.fabric.microsoft.com/.default
POWERBI_SCOPE=https://analysis.windows.net/powerbi/api/.default

# --- Scope ------------------------------------------------------------------------------
# Comma- or whitespace-separated workspace GUIDs. Start with one test workspace.
# Empty means every workspace the identity can see.
# Example: WORKSPACE_IDS=11111111-1111-1111-1111-111111111111,22222222-2222-2222-2222-222222222222
# WORKSPACE_IDS=

# --- Report labels ----------------------------------------------------------------------
CLIENT_NAME=Contoso
ENGAGEMENT_NAME=FAR Architecture Review
REVIEWER_NAME=
REVIEW_DATE=

# --- Temporary workspace access (optional, off by default) -------------------------------
# To read the row-level and object-level security of the models you declared, the identity
# needs write access to them, which the Fabric Administrator role does not give. When true,
# and the identity is a Fabric administrator, the review adds it to a workspace only where a
# declared model could not be read, reads, and removes it again. See docs/auth-setup.md.
# ACCESS_GRANT_ENABLED=false
# ACCESS_GRANT_ROLE=auto

# --- Semantic model role detail (optional, off by default) -------------------------------
# When true, the review also keeps each model's role names, permission and per-role counts
# (tables with a row filter, hidden tables and columns, dynamic or static filter). Filter text,
# table and column names and members are never kept. Role names then show in the reports and agents.
# MODEL_SECURITY_ROLE_DETAIL=false

# Optional PDF branding: empty means no organization label or logo.
# REPORT_BRAND=
# REPORT_LOGO=
# FOOTER_LABEL=

# --- Output -----------------------------------------------------------------------------
# Use a separate directory per engagement, for example output/far/contoso.
OUTPUT_DIR=output/far

# Thresholds and rule settings are not environment variables: edit config/thresholds.yaml
# and config/policy.yaml.
